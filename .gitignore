# the record is the database and the fetched files; both are synced with
# tools/history-sync.sh, not committed. What is committed: the code, the
# brief, each topic's RESUME.md and notes/, and the staging manifest.
db/history/*.sqlite*
db/history/*/files/
db/history/_staging/*
!db/history/_staging/MANIFEST.md
db/history/_ledger/
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
db/history/_backups/
db/history/SIGNATURE.txt
.ocr-venv/
# the ship's front-end work-in-progress lives in underway/ inside its clone;
# grid never sees it and neither should git on either side
underway/
.route-venv/
# YOLO11x weights for tools/animal-crops.py: 115 MB, fetched not committed
tools/models/*.pt
# researchers' working files live outside the tree, in /data/dev/arctic-history-scratch/<slug>/
*scratch*/
scratch/
.hf-cache/
err.log
# the routing ledger's outputs are regenerated; only its hand-made inputs are kept
db/history/_ledger/routing/terrain/gallery.html
db/history/_ledger/routing/terrain/routes.geojson
db/history/_ledger/routing/terrain/summary.md
