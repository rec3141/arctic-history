# the record is the database and the fetched files; both are synced with
# tools/history-sync.sh, not committed. What is committed: the code, the
# brief, each topic's RESUME.md and notes/, and the staging manifest.
db/history/*.sqlite*
db/history/*/files/
db/history/_staging/*
!db/history/_staging/MANIFEST.md
db/history/_ledger/
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
db/history/_backups/
db/history/SIGNATURE.txt
.ocr-venv/
# the ship's front-end work-in-progress lives in underway/ inside its clone;
# grid never sees it and neither should git on either side
underway/
